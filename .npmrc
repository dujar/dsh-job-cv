# The plugin's peer deps (react, @deepseek-ai/dsh-*, @deepseek-ai/cordis) are
# also its DEV deps: the test suite builds and imports the client bundle, which
# imports react, and the route tests load the harness types. They resolve from
# the public registry (see package-lock.json), so let npm install them the
# normal way — `npm install` / `npm ci` both need them present.
legacy-peer-deps=false
